# Copier en .env (jamais commité)

# PostgreSQL 18 local
DATABASE_URL=postgres://jobhunt:CHANGE_ME@localhost:5432/jobhunt

# API Anthropic (optionnelle : sans clé, pas de scoring LLM, tri par rule_score)
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-haiku-4-5
OUTREACH_MODEL=claude-sonnet-5

# Token partagé avec l'extension Chrome (32 caractères minimum)
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTURE_TOKEN=

# API France Travail (francetravail.io) — optionnel tant que la source n'est pas activée
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

APP_URL=http://127.0.0.1:3000
